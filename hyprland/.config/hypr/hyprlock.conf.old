source = ~/.config/hypr/hyprlock-colors.conf

$font = Google Sans Flex Freeze

general {
    hide_cursor = true
}

background {
    monitor =
    path = /usr/share/sddm/themes/pixie/assets/background.jpg
    blur_passes = 3
    blur_size = 6
    brightness = 0.7
}

# Stacked clock: hours on top, minutes below in the accent color
label {
    monitor =
    text = cmd[update:1000] date +"%H"
    font_size = 150
    font_family = $font
    color = $text

    position = 0, 230
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] date +"%M"
    font_size = 150
    font_family = $font
    color = $accent

    position = 0, 85
    halign = center
    valign = center
}

# DATE
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    font_size = 22
    font_family = $font
    color = $subtext

    position = 0, -10
    halign = center
    valign = center
}

# Circular avatar
image {
    monitor =
    path = /usr/share/sddm/themes/pixie/assets/avatar.jpg
    size = 96
    rounding = -1
    border_size = 2
    border_color = $accent

    position = 0, -100
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 320, 56
    rounding = -1
    outline_thickness = 2
    outer_color = $accent
    inner_color = $surface
    font_color = $text
    check_color = $accent
    fail_color = $error
    fade_on_empty = false
    font_family = $font
    placeholder_text = Password
    fail_text = $PAMFAIL
    dots_spacing = 0.3

    position = 0, -190
    halign = center
    valign = center
}
